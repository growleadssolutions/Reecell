---
import { business } from '../../data/business';
const number = business.whatsapp.replace(/\D/g, '');
if (!/^\d{10,15}$/.test(number)) throw new Error('Configure um WhatsApp válido em business.ts.');
const href = `https://wa.me/${number}?text=${encodeURIComponent('Olá! Gostaria de pedir um orçamento para meu celular.')}`;
---
<a class="floating-whatsapp" href={href} aria-label="Conversar com a ReeCell pelo WhatsApp" data-cta="whatsapp" data-cta-location="floating">
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M20.52 3.48A11.9 11.9 0 0 0 12.05 0C5.47 0 .12 5.35.12 11.93c0 2.1.55 4.15 1.6 5.96L.02 24l6.25-1.64a11.94 11.94 0 0 0 5.77 1.47h.01C18.62 23.83 24 18.48 24 11.9c0-3.19-1.24-6.18-3.48-8.42ZM12.05 21.8a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.71.97.99-3.62-.24-.37a9.87 9.87 0 0 1-1.52-5.26c0-5.47 4.45-9.92 9.93-9.92a9.85 9.85 0 0 1 7.02 2.91 9.85 9.85 0 0 1 2.9 7.02c0 5.47-4.46 9.86-9.96 9.86Zm5.44-7.43c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z" />
  </svg>
  <span>Fale pelo WhatsApp</span>
</a>

<style>
  .floating-whatsapp {
    position: fixed;
    right: calc(24px + env(safe-area-inset-right, 0px));
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    z-index: 30;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 56px;
    padding: 14px 22px;
    border: 2px solid white;
    border-radius: 999px;
    background: #087e45;
    color: white;
    box-shadow: 0 6px 24px rgb(0 0 0 / 20%);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .floating-whatsapp svg { width: 28px; height: 28px; flex: none; }
  .floating-whatsapp:focus-visible { outline: 3px solid #602a59; outline-offset: 4px; }
  @media (hover: hover) { .floating-whatsapp:hover { background: #066638; } }
  /* Keep the final footer links reachable above the floating control. */
  :global(.site-footer) { padding-bottom: calc(104px + env(safe-area-inset-bottom, 0px)); }
  @media (max-width: 767px) {
    .floating-whatsapp {
      right: calc(16px + env(safe-area-inset-right, 0px));
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      width: 56px;
      height: 56px;
      padding: 12px;
    }
    .floating-whatsapp span { display: none; }
    :global(body:has(.mobile-menu[open])) .floating-whatsapp { visibility: hidden; }
  }
  @media print { .floating-whatsapp { display: none; } }
</style>
