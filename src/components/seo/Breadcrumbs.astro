---
import type { BreadcrumbItem } from '../../lib/structured-data';
interface Props { items: BreadcrumbItem[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Caminho de navegação"><ol>{items.map((item, index) => <li>{index === items.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href}>{item.name}</a>}</li>)}</ol></nav>
